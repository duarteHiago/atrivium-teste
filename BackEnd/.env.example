# Configurações do Servidor
PORT=3001

# Configurações do Banco de Dados PostgreSQL (Docker)
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=<senha_segura>
DB_DATABASE=atrivium-database
JWT_SECRET=<seu_secret>
ENCRYPTION_KEY=<chave_criptografia>

# Leonardo AI API Key (obtenha em https://app.leonardo.ai/settings)
LEONARDO_API_KEY=sua-chave-da-api-leonardo

# Pinata (IPFS) - Obtenha em https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=sua-pinata-api-key
PINATA_SECRET_API_KEY=sua-pinata-secret-api-key
# Opcional: JWT (alternativa ao API Key + Secret)
# PINATA_JWT=seu-pinata-jwt
# Opcional: Gateway customizado (ex: seu-subdominio.mypinata.cloud)
# PINATA_GATEWAY=gateway.pinata.cloud
# Opcional: Subdomínio customizado para URLs dedicadas
# PINATA_SUBDOMAIN=seu-subdominio.mypinata.cloud

# Futuras integrações (deixar vazio por enquanto)
# ETHEREUM_RPC_URL=
# POLYGON_RPC_URL=
