# ========================================
# CONFIGURAÇÕES DO SERVIDOR - STAGING
# ========================================
PORT=3001
NODE_ENV=staging

# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ========================================
# PostgreSQL (Homologação)
DB_HOST=staging-db.atrivium.com
DB_PORT=5432
DB_USER=staging_user
DB_PASSWORD=staging_secure_password
DB_DATABASE=atrivium-staging-db

# ========================================
# SEGURANÇA E AUTENTICAÇÃO
# ========================================
# JWT - JSON Web Token
JWT_SECRET=staging_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Criptografia de Dados Sensíveis
ENCRYPTION_KEY=staging_encryption_key_32_bytes_change_prod

# ========================================
# API KEYS - SERVIÇOS EXTERNOS
# ========================================
# Leonardo AI - Geração de Imagens
LEONARDO_API_KEY=your_staging_leonardo_api_key

# HuggingFace - IA e Machine Learning
HUGGINGFACE_API_KEY=your_staging_huggingface_api_key

# Pinata IPFS - Armazenamento Descentralizado
PINATA_API_KEY=your_staging_pinata_api_key
PINATA_SECRET_API_KEY=your_staging_pinata_secret_key
PINATA_JWT=

# Ngrok - Túnel HTTP (não usar em staging)
NGROK_TOKEN=

# ========================================
# CONFIGURAÇÕES DE CORS
# ========================================
CORS_ORIGIN=https://staging.atrivium.com

# ========================================
# CONFIGURAÇÕES DE UPLOAD
# ========================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads/staging

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# ========================================
# LOGS E MONITORAMENTO
# ========================================
LOG_LEVEL=info

# ========================================
# FRONTEND (VITE)
# ========================================
VITE_API_BASE=https://api-staging.atrivium.com

# ========================================
# URL PÚBLICA
# ========================================
PUBLIC_BASE_URL=https://api-staging.atrivium.com