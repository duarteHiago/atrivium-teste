# ========================================
# CONFIGURAÇÕES DO SERVIDOR - DEVELOPMENT
# ========================================
PORT=3001
NODE_ENV=development

# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ========================================
# PostgreSQL (Docker Local)
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=devpassword
DB_DATABASE=atrivium-database

# ========================================
# SEGURANÇA E AUTENTICAÇÃO
# ========================================
# JWT - JSON Web Token
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Criptografia de Dados Sensíveis
ENCRYPTION_KEY=dev_encryption_key_32_bytes_change_prod

# ========================================
# API KEYS - SERVIÇOS EXTERNOS
# ========================================
# Leonardo AI - Geração de Imagens
LEONARDO_API_KEY=52f31d93-3cc7-45e5-a979-b458cb2db075

# HuggingFace - IA e Machine Learning
HUGGINGFACE_API_KEY=your_dev_huggingface_api_key

# Pinata IPFS - Armazenamento Descentralizado
PINATA_API_KEY=e194601e5bc108fa573b
PINATA_SECRET_API_KEY=c7ecba98d6e389b239574a98e99d1a96155505dd9f15d279b6a3065af4a0323b
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..HKaFNRFofpX5OuFqGWdjDF9OfZU8aeSIBPHhs9MYnIM

# Ngrok - Túnel HTTP (opcional para desenvolvimento)
NGROK_TOKEN=

# ========================================
# CONFIGURAÇÕES DE CORS
# ========================================
CORS_ORIGIN=http://localhost:5173

# ========================================
# CONFIGURAÇÕES DE UPLOAD
# ========================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads/development

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# LOGS E MONITORAMENTO
# ========================================
LOG_LEVEL=debug

# ========================================
# FRONTEND (VITE)
# ========================================
VITE_API_BASE=http://localhost:3001

# ========================================
# URL PÚBLICA
# ========================================
PUBLIC_BASE_URL=http://localhost:3001