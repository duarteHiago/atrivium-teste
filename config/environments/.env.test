# ========================================
# CONFIGURAÇÕES DO SERVIDOR - TEST
# ========================================
PORT=3002
NODE_ENV=test

# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ========================================
# PostgreSQL (Testes - Docker)
DB_HOST=localhost
DB_PORT=5434
DB_USER=test_user
DB_PASSWORD=test_password
DB_DATABASE=atrivium-test-db

# ========================================
# SEGURANÇA E AUTENTICAÇÃO
# ========================================
# JWT - JSON Web Token
JWT_SECRET=test_jwt_secret_key
JWT_EXPIRES_IN=7d

# Criptografia de Dados Sensíveis
ENCRYPTION_KEY=test_encryption_key_32_bytes_for_testing

# ========================================
# API KEYS - SERVIÇOS EXTERNOS
# ========================================
# Leonardo AI - Geração de Imagens
LEONARDO_API_KEY=your_test_leonardo_api_key

# HuggingFace - IA e Machine Learning
HUGGINGFACE_API_KEY=your_test_huggingface_api_key

# Pinata IPFS - Armazenamento Descentralizado (mock em testes)
PINATA_API_KEY=test_pinata_key
PINATA_SECRET_API_KEY=test_pinata_secret
PINATA_JWT=

# Ngrok - Túnel HTTP (não usar em testes)
NGROK_TOKEN=

# ========================================
# CONFIGURAÇÕES DE CORS
# ========================================
CORS_ORIGIN=http://localhost:5174

# ========================================
# CONFIGURAÇÕES DE UPLOAD
# ========================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads/test

# ========================================
# RATE LIMITING
# ========================================
# Desativado para testes
RATE_LIMIT_WINDOW_MS=0
RATE_LIMIT_MAX_REQUESTS=0

# ========================================
# LOGS E MONITORAMENTO
# ========================================
LOG_LEVEL=debug

# ========================================
# FRONTEND (VITE)
# ========================================
VITE_API_BASE=http://localhost:3002

# ========================================
# URL PÚBLICA
# ========================================
PUBLIC_BASE_URL=http://localhost:3002