# ========================================
# CONFIGURAÇÕES DO SERVIDOR - PRODUCTION
# ========================================
PORT=3000
NODE_ENV=production

# ========================================
# CONFIGURAÇÕES DO BANCO DE DADOS
# ========================================
# PostgreSQL (Produção)
DB_HOST=production-db.atrivium.com
DB_PORT=5432
DB_USER=production_user
DB_PASSWORD=production_very_secure_password
DB_DATABASE=atrivium-production-db

# ========================================
# SEGURANÇA E AUTENTICAÇÃO
# ========================================
# JWT - JSON Web Token
JWT_SECRET=production_very_secure_jwt_secret_key
JWT_EXPIRES_IN=7d

# Criptografia de Dados Sensíveis
ENCRYPTION_KEY=production_very_secure_encryption_key_32_bytes

# ========================================
# API KEYS - SERVIÇOS EXTERNOS
# ========================================
# Leonardo AI - Geração de Imagens
LEONARDO_API_KEY=your_production_leonardo_api_key

# HuggingFace - IA e Machine Learning
HUGGINGFACE_API_KEY=your_production_huggingface_api_key

# Pinata IPFS - Armazenamento Descentralizado
PINATA_API_KEY=your_production_pinata_api_key
PINATA_SECRET_API_KEY=your_production_pinata_secret_key
PINATA_JWT=

# Ngrok - Túnel HTTP (não usar em produção)
NGROK_TOKEN=

# ========================================
# CONFIGURAÇÕES DE CORS
# ========================================
CORS_ORIGIN=https://atrivium.com

# ========================================
# CONFIGURAÇÕES DE UPLOAD
# ========================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_DIR=uploads/production

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# ========================================
# LOGS E MONITORAMENTO
# ========================================
LOG_LEVEL=error

# Sentry - Rastreamento de Erros
SENTRY_DSN=your_sentry_dsn

# New Relic - Monitoramento de Performance
NEW_RELIC_LICENSE_KEY=your_new_relic_key

# ========================================
# CACHE
# ========================================
REDIS_URL=redis://production-redis.atrivium.com:6379

# ========================================
# SSL/TLS
# ========================================
SSL_KEY_PATH=/etc/ssl/private/atrivium.key
SSL_CERT_PATH=/etc/ssl/certs/atrivium.crt

# ========================================
# FRONTEND (VITE)
# ========================================
VITE_API_BASE=https://api.atrivium.com

# ========================================
# URL PÚBLICA
# ========================================
PUBLIC_BASE_URL=https://api.atrivium.com